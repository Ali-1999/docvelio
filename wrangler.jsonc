{
  "name": "docvelio",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "node scripts/extend-toolkit.cjs && node scripts/build-blogs.cjs && node scripts/build-docvelio.cjs && node scripts/site-shell.cjs && node scripts/page-content.cjs && node scripts/apply-design.cjs && node scripts/seo-audit-fixes.cjs && node scripts/add-image-studio.cjs && node scripts/image-seo-pages.cjs && node scripts/build-cargo-tools.cjs && node scripts/ensure-yandex-verification.cjs && node scripts/build-wheel-picker.cjs && node scripts/final-global-shell.cjs && node scripts/optimize-site.cjs && node scripts/seo-growth.cjs && node scripts/add-search-answers.cjs && node scripts/audit-seo-final.cjs && node scripts/audit-seo.cjs && node scripts/build-excel-formula.cjs && node scripts/build-europe-tools.cjs && node scripts/redesign-home-toolkit.cjs && node scripts/redesign-full-homepage.cjs && node scripts/ensure-organization-schema.cjs && node scripts/fix-ahrefs-metadata.cjs && node scripts/refresh-guide-descriptions.cjs && node scripts/install-adsense.cjs && node scripts/implement-internal-links.cjs && node scripts/install-fazier-badge.cjs && node scripts/optimize-homepage-css.cjs && node scripts/integrate-qr-barcode.cjs && node scripts/install-tiktok-tool.cjs && node scripts/install-ga4.cjs && node scripts/check-adsense-readiness.cjs && node scripts/audit-adsense-site-quality.cjs"
  },
  "main": "src/excel-formula-worker.js",
  "ai": {
    "binding": "AI"
  }
}
