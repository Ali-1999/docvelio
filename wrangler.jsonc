{
  "name": "docvelio",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "build": {
    "command": "node scripts/extend-toolkit.cjs && node scripts/build-blogs.cjs && node scripts/build-docvelio.cjs && node scripts/site-shell.cjs && node scripts/page-content.cjs && node scripts/apply-design.cjs && node scripts/seo-audit-fixes.cjs && node scripts/add-image-studio.cjs"
  }
}
